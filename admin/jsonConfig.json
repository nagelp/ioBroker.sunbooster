{
  "i18n": true,
  "type": "tabs",
  "items": {
    "_device": {
      "type": "panel",
      "label": "Device & tokens",
      "items": {
        "_info": {
          "type": "staticText",
          "newLine": true,
          "text": "Enter the values printed by tools/extract-credentials.js (see the README for how to capture a login). Tokens rotate automatically; the refresh token is valid ~30 days.",
          "sm": 12
        },
        "accessToken": {
          "type": "text",
          "label": "Access token",
          "help": "Full value starting with 'Bearer '",
          "newLine": true,
          "sm": 12,
          "md": 12
        },
        "refreshToken": {
          "type": "text",
          "label": "Refresh token",
          "help": "Full value starting with 'Bearer '",
          "newLine": true,
          "sm": 12,
          "md": 12
        },
        "accessExpiration": {
          "type": "number",
          "label": "Access token expiry (unix seconds)",
          "newLine": true,
          "sm": 12,
          "md": 6
        },
        "refreshExpiration": {
          "type": "number",
          "label": "Refresh token expiry (unix seconds)",
          "sm": 12,
          "md": 6
        },
        "uid": {
          "type": "text",
          "label": "User id (uid)",
          "newLine": true,
          "sm": 12,
          "md": 4
        },
        "productKey": {
          "type": "text",
          "label": "Product key",
          "sm": 12,
          "md": 4
        },
        "deviceKey": {
          "type": "text",
          "label": "Device key",
          "sm": 12,
          "md": 4
        }
      }
    },
    "_advanced": {
      "type": "panel",
      "label": "Advanced",
      "items": {
        "updateInterval": {
          "type": "number",
          "label": "Live update interval (seconds)",
          "help": "Every N seconds the adapter asks the device to push live values, as the app does while it is open. 0 disables it (values then only update when the device reports on its own). Minimum 5.",
          "min": 0,
          "max": 3600,
          "newLine": true,
          "sm": 12,
          "md": 6
        },
        "wsUrl": {
          "type": "text",
          "label": "WebSocket URL",
          "newLine": true,
          "sm": 12,
          "md": 6
        },
        "apiBase": {
          "type": "text",
          "label": "REST API base URL",
          "sm": 12,
          "md": 6
        }
      }
    }
  }
}
