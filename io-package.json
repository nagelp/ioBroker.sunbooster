{
  "common": {
    "name": "sunbooster",
    "version": "0.3.0",
    "title": "Sunbooster® Powerstation GRID/GRID+",
    "titleLang": {
      "en": "Sunbooster® Powerstation GRID/GRID+",
      "de": "Sunbooster® Powerstation GRID/GRID+"
    },
    "desc": {
      "en": "Monitor and control the Sunbooster® Powerstation GRID / GRID+ (charging and feed-in) via the vendor cloud.",
      "de": "Überwachung und Steuerung der Sunbooster® Powerstation GRID / GRID+ (Laden und Einspeisung) über die Hersteller-Cloud."
    },
    "authors": [
      "nagelp"
    ],
    "keywords": [
      "sunbooster",
      "powerstation",
      "battery",
      "energy"
    ],
    "license": "MIT",
    "platform": "Javascript/Node.js",
    "main": "main.js",
    "icon": "sunbooster.png",
    "enabled": true,
    "extIcon": "https://raw.githubusercontent.com/nagelp/ioBroker.sunbooster/main/admin/sunbooster.png",
    "readme": "https://github.com/nagelp/ioBroker.sunbooster/blob/main/README.md",
    "mode": "daemon",
    "type": "energy",
    "compact": true,
    "connectionType": "cloud",
    "dataSource": "push",
    "adminUI": {
      "config": "json"
    },
    "dependencies": [
      {
        "js-controller": ">=5.0.19"
      }
    ],
    "messagebox": false,
    "news": {
      "0.3.0": {
        "en": "Tokens are now stored encrypted and no longer in the readable info.tokens state. Re-enter the tokens in the adapter settings after updating and delete info.tokens.",
        "de": "Tokens werden jetzt verschlüsselt gespeichert und nicht mehr im lesbaren Datenpunkt info.tokens. Nach dem Update die Tokens in den Adapter-Einstellungen neu eingeben und info.tokens löschen."
      },
      "0.2.3": {
        "en": "Updated README and meta data",
        "de": "README und Metadaten aktualisiert"
      },
      "0.2.1": {
        "en": "Add adapter icon",
        "de": "Adapter-Icon hinzugefügt"
      },
      "0.2.0": {
        "en": "Live updates: periodically ask the device to push current values (configurable interval)",
        "de": "Live-Werte: Gerät wird regelmäßig zum Senden aktueller Werte aufgefordert (Intervall einstellbar)"
      },
      "0.1.0": {
        "en": "Initial release",
        "de": "Erste Version"
      }
    }
  },
  "native": {
    "accessToken": "",
    "refreshToken": "",
    "accessExpiration": 0,
    "refreshExpiration": 0,
    "uid": "",
    "productKey": "",
    "deviceKey": "",
    "updateInterval": 10,
    "wsUrl": "wss://iot-ws.quecteleu.com/ws/v1",
    "apiBase": "https://iot-api.acceleronix.io"
  },
  "encryptedNative": [
    "accessToken",
    "refreshToken"
  ],
  "protectedNative": [
    "accessToken",
    "refreshToken"
  ],
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": "Information"
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "role": "indicator.connected",
        "name": "Cloud connection established",
        "type": "boolean",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    }
  ]
}
